# Target Hardware (360T7 / MT7981)
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7=y

# Kernel & Base Options
CONFIG_LINUX_6_6=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# --------------------------------------------------
# Explicitly Disabled Packages (剔除指定插件及核心依赖)
# --------------------------------------------------

# 禁用 PassWall 及相关核心/依赖
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-i18n-passwall-zh-cn is not set
# CONFIG_PACKAGE_passwall-packages is not set
# CONFIG_PACKAGE_passwall-luci is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_v2ray-core is not set

# 禁用 ddns-go
# CONFIG_PACKAGE_ddns-go is not set
# CONFIG_PACKAGE_luci-app-ddns-go is not set
# CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn is not set

# 禁用 KMS 服务器 (vlmcsd)
# CONFIG_PACKAGE_vlmcsd is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn is not set

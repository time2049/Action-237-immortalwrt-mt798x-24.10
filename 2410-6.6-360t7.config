# ==========================================================
# 360 T7 / MT7981 / Filogic
# ImmortalWrt 24.10 / Kernel 6.6
# 纯净版
# ==========================================================

# ----------------------------------------------------------
# Target
# ----------------------------------------------------------

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7=y

# Kernel 6.6
CONFIG_LINUX_6_6=y

# ----------------------------------------------------------
# Build
# ----------------------------------------------------------

CONFIG_DEVEL=y
CONFIG_CCACHE=y

# ----------------------------------------------------------
# LuCI
# ----------------------------------------------------------

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y

# 中文
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# ----------------------------------------------------------
# 基础网络
# ----------------------------------------------------------

CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y

# ----------------------------------------------------------
# WiFi
#
# 360T7 的 MTK WiFi 驱动由目标源码自身提供。
# 不在这里强行添加 MT76 / 第三方 WiFi 驱动。
# ----------------------------------------------------------

# ----------------------------------------------------------
# USB
# ----------------------------------------------------------

CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y

# ----------------------------------------------------------
# 常用工具
# ----------------------------------------------------------

CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y

# ----------------------------------------------------------
# IPv6
# ----------------------------------------------------------

CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcp6c-ext-cprefix=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# ==========================================================
# 明确禁用 PassWall
# ==========================================================

# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-i18n-passwall-zh-cn is not set
# CONFIG_PACKAGE_passwall-packages is not set
# CONFIG_PACKAGE_passwall-luci is not set

# ==========================================================
# 明确禁用代理核心
# ==========================================================

# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_v2ray-core is not set
# CONFIG_PACKAGE_v2ray-plugin is not set
# CONFIG_PACKAGE_xray-plugin is not set

# ==========================================================
# 明确禁用 PassWall 相关依赖
# ==========================================================

# CONFIG_PACKAGE_chinadns-ng is not set
# CONFIG_PACKAGE_dns2tcp is not set
# CONFIG_PACKAGE_dns2socks is not set
# CONFIG_PACKAGE_haproxy is not set
# CONFIG_PACKAGE_naiveproxy is not set
# CONFIG_PACKAGE_shadowsocks-rust is not set
# CONFIG_PACKAGE_trojan-plus is not set

# ==========================================================
# 明确禁用 DDNS-Go
# ==========================================================

# CONFIG_PACKAGE_ddns-go is not set
# CONFIG_PACKAGE_luci-app-ddns-go is not set
# CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn is not set

# ==========================================================
# 明确禁用 VLMCSd
# ==========================================================

# CONFIG_PACKAGE_vlmcsd is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn is not set
